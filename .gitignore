# --- Python & Jupyter ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Datasets (Trop lourd) ---
# On ignore tout le contenu du dossier chest_xray (les milliers d'images)
chest_xray/**/*

# MAIS on force Git à garder les fichiers .gitkeep (ce qui maintiendra l'architecture visible)
!chest_xray/**/.gitkeep

# On garde aussi ton fichier JSON de paramètres de drift (très utile pour la reproductibilité)
!chest_xray/**/*.json
Archive/

# --- Gros Checkpoints & Artefacts (Trop lourd) ---
checkpoints/*.pth
checkpoints/*.pt
# On garde les petits fichiers de métriques .pt s'ils sont légers, sinon tout exclure :
# checkpoints/

# On garde les modèles ONNX s'ils font < 100Mo (DenseNet fait ~30Mo donc OK)
# Si tes fichiers .onnx.data sont énormes, décommente la ligne suivante :
# artifacts/*.data

# --- Logs & Runs (Optionnel, garder si tu veux montrer les preuves) ---
# runs/
# artifacts/monitoring/tensorboard/

# --- LaTeX build files (inutile sur git) ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.pdf


# --- OS ---
.DS_Store
Thumbs.db